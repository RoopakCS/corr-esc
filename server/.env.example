# Server Port
PORT=4000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/corr_esc?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/corr_esc

# Secret key used for signing and verifying JWT authentication tokens
JWT_SECRET=corr-esc-development-super-secret-key-change-in-production!

# Cloudinary (Used for photo evidence attachments in Phase 1 / Phase 2)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
